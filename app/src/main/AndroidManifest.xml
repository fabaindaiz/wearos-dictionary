<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!--
      INTERNET, y recien ahora. D-167 decidio que el manifest no pide permisos que no usa, y
      hasta que existio el catalogo de descarga este no se usaba: los packs entraban por cable
      con devpack.py. Es un permiso de instalacion, no pide dialogo.

      ⚠️ Lo que NO se declara: `ACCESS_NETWORK_STATE`. Las restricciones de D-029 —cargando y
      Wi-Fi— las impone WorkManager, que no necesita que la app mire el estado de la red.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      roundIcon se declara a proposito: sin el, un reloj REDONDO recorta el icono cuadrado.
      El recurso estaba en res/ desde el template y nadie lo declaraba.
    -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:appCategory="productivity"
        android:theme="@android:style/Theme.DeviceDefault">
        <!--
          Dos tiles, y NINGUNO declara androidx.wear.tiles.GROUP: el javadoc dice que "tile
          providers in the same group represent the same tile on the device", y el default del
          grupo es el nombre de la clase. Declararlo los fundiria en uno solo.
        -->
        <service
            android:name=".tile.HistoryTileService"
            android:exported="true"
            android:label="@string/tile_history_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>

            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview_history" />
        </service>
        <service
            android:name=".tile.WordOfTheDayTileService"
            android:exported="true"
            android:label="@string/tile_word_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>

            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview_word" />
        </service>

        <uses-library
            android:name="com.google.android.wearable"
            android:required="true" />
        <uses-library
            android:name="wear-sdk"
            android:required="false" />
        <!--
               Set to true if your app is Standalone, that is, it does not require the handheld
               app to run.
        -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/MainActivityTheme.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>