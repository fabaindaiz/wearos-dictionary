# --- Gradle y build ---
.gradle/
build/
captures/
.cxx/
*.hprof

# Kotlin Gradle plugin, ver https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/

# --- Especifico de la maquina ---
# Contiene la ruta absoluta al SDK de Android: no es portable entre maquinas.
local.properties

# --- IDE ---
# .idea/ entero: Android Studio lo reescribe en cada sync, y workspace.xml guarda estado de
# maquina (layout de ventanas, tabs abiertos, estado de run configurations).
#
# El estilo de codigo NO se pierde: vive en .editorconfig, que es portable y lo respetan
# Android Studio, VS Code y los linters. Esa es la forma correcta de compartirlo.
.idea/
*.iml

# --- Artefactos generados del proyecto ---
# Assets de los tests instrumentados: TODO lo que hay ahi lo genera
# :dict-data:prepareAndroidTestAssets (el pack de juguete y una copia de los vectores).
# No se commitean: el pack es un binario que cambia en cada build por meta.built_at, y la
# copia de los vectores seria una segunda fuente de verdad del contrato mas importante del repo.
dict-data/src/androidTest/assets/

# Cache de bytecode de Python del pipeline de packs
__pycache__/
*.py[cod]

# Entornos y cache de Hatch / ruff. pyproject.toml SI va al repo.
.venv/
.hatch/
.ruff_cache/
*.egg-info/
dist/

# --- Java ---
*.class
*.log
*.ctxt
.mtj.tmp/
*.jar
*.war
*.nar
*.ear
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# El jar del wrapper de Gradle SI va al repo: es el punto del wrapper. Sin el, un clone no
# puede correr ./gradlew. La regla *.jar de mas arriba lo excluia, y por eso nunca estuvo
# trackeado en este repo.
!gradle/wrapper/gradle-wrapper.jar

# El pack de demo lo genera :app:buildDemoPack en cada build; los diccionarios reales pesan
# decenas o cientos de MB y ni siquiera viajan en el APK. Ninguno va al repo.
app/src/main/assets/*.db
!app/src/main/assets/.gitkeep

# Los packs reales, que build_pack.py escribe donde le digas -- y toda la documentacion lo
# invoca desde la raiz. Son 69 MB (espanol) y 295 MB (ingles): sin esta regla, un `git add -A`
# despues de construir uno se lleva el binario al repo.
/*.db

# Una keystore nunca va al repositorio: vive fuera del proyecto y local.properties
# guarda solo su ruta. Esto es el segundo cinturon.
*.jks
*.keystore
